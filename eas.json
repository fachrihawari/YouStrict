{
  "cli": {
    "version": ">= 25.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "autoIncrement": true,
      "env": {
        "EXPO_TV": "1"
      },
      "distribution": "internal",
      "channel": "preview"
    },
    "preview": {
      "extends": "base",
      "android": {
        "buildType": "apk",
        "withoutCredentials": true
      }
    },
    "release": {
      "extends": "base",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_TV": "1",
        "BUILD_ARCHS": "arm64-v8a,armeabi-v7a"
      }
    },
    "release-arm64": {
      "extends": "release",
      "env": {
        "EXPO_TV": "1",
        "BUILD_ARCHS": "arm64-v8a"
      }
    },
    "release-armv7": {
      "extends": "release",
      "env": {
        "EXPO_TV": "1",
        "BUILD_ARCHS": "armeabi-v7a"
      }
    }
  }
}
