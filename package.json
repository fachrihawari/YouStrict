{
  "name": "youstrict",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "EXPO_TV=1 expo start",
    "android:tv": "EXPO_TV=1 expo run:android",
    "android": "expo run:android",
    "prebuild:tv": "EXPO_TV=1 expo prebuild --clean",
    "prebuild": "expo prebuild --clean",
    "catalog:build": "bun scripts/build-catalog.ts --out dist",
    "catalog:add": "bun scripts/add-channel.ts",
    "test": "bun test",
    "typegen": "bun scripts/typegen.ts",
    "typecheck": "bun run typegen && tsc --noEmit",
    "update": "EXPO_TV=1 eas update --channel preview --platform android"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.15",
    "@shopify/flash-list": "2.3.2",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "expo": "~58.0.19",
    "expo-asset": "~58.0.18",
    "expo-audio": "~58.0.10",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.15",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.26",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.11",
    "expo-sqlite": "~58.0.14",
    "expo-status-bar": "~58.0.4",
    "expo-updates": "~58.0.18",
    "react": "19.3.0",
    "react-native": "npm:react-native-tvos@0.88.0-0",
    "react-native-qrcode-svg": "^6.3.27",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0",
    "react-native-youtube-bridge": "^2.2.4",
    "tailwindcss": "^4.3.3",
    "uniwind": "^1.13.0"
  },
  "devDependencies": {
    "@react-native-tvos/config-tv": "^0.1.7",
    "@types/bun": "^1.4.4",
    "@types/react": "~19.3.0",
    "babel-plugin-inline-import": "^3.0.0",
    "bun-types": "^1.4.4",
    "drizzle-kit": "^0.31.11",
    "typescript": "~6.0.3"
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native"
      ]
    }
  },
  "private": true
